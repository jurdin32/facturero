# Servicio de systemd para CELERY BEAT de facturero (las tareas periódicas).
#
#   sudo cp facturero-celery-beat.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now facturero-celery-beat

# O sin copiarlo: se queda aquí y systemd lo usa desde esta carpeta
#   sudo systemctl enable --now __PROYECTO__/deploy/systemd/facturero-celery-beat.service
#   (crea el enlace en /etc/systemd/system y el del arranque automático; la
#    carpeta debe estar en el disco raíz, no en /home ni /var de otra partición)
#   Lo hace por usted:  sudo python manage.py servicios_celery --enlazar
#
# Ajuste los mismos cuatro marcadores que en el worker
# (__USUARIO__ __GRUPO__ __PROYECTO__ __VENV__).
#
# Beat lanza CELERY_BEAT_SCHEDULE (settings.py, con planificador()):
#   · sri_fe.revisar_certificado    todos los días a las 7:00 (hora de CELERY_TIMEZONE)
#   · sri_fe.reintentar_pendientes  cada 10 minutos

[Unit]
Description=Celery beat de facturero (revisa la firma y reintenta los pendientes)
Documentation=https://github.com/jurdin32/factec
After=network-online.target
Wants=network-online.target
#After=redis-server.service
#Wants=redis-server.service

[Service]
Type=simple
User=__USUARIO__
Group=__GRUPO__
WorkingDirectory=__PROYECTO__

Environment="DJANGO_SETTINGS_MODULE=facturero.settings"
Environment="PYTHONUNBUFFERED=1"
Environment="FORKED_BY_MULTIPROCESSING=1"
EnvironmentFile=-__PROYECTO__/.env

# systemd crea /var/lib/facturero y lo deja a nombre del usuario del servicio:
# ahí va el calendario de beat, sin tener que darle permisos a mano.
StateDirectory=facturero
ExecStart=__VENV__/bin/celery -A facturero beat -l info --schedule=/var/lib/facturero/celerybeat-schedule

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
