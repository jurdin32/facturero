# Cópielo como facturero/.env en el servidor: los tres servicios lo cargan solos
# (así lo indica su EnvironmentFile). No lo suba al repositorio.

# Clave con la que el paquete cifra la contraseña del .p12 (SRI_CLAVE_CIFRADO).
# Genérela con:
#   python -c "from factec.django.crypto import generar_clave; print(generar_clave())"
SRI_CLAVE_CIFRADO=

# El broker de Celery. En settings.py ya se lee del entorno:
#   CELERY_BROKER_URL = os.environ.get("CELERY_BROKER_URL", "redis://localhost:6379/0")
# Con contraseña:  redis://:la-clave@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Ambiente del SRI, si quiere forzarlo desde fuera: pruebas | producción
# SRI_AMBIENTE=pruebas
